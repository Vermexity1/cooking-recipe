DATABASE_URL="postgres://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional comma-separated or newline-separated seed keys for Vercel.
# You can also seed from apps/web/private/invite-keys.json locally.
INVITE_KEYS="VEIL-XXXX-XXXX-XXXX-XXXX,VEIL-YYYY-YYYY-YYYY-YYYY"

# Optional remote Chromium worker pool. Add as many as you actually deploy.
# /api/vm/launch health-checks these and sends users to the fastest healthy one,
# then uses Vercel Sandbox only if no worker is available.
VM_WORKER_AUTH_TOKEN="replace-with-a-long-random-token"
RENDER_VM_WORKER_URL="https://your-render-service.onrender.com"
KOYEB_VM_WORKER_URL="https://your-koyeb-app.koyeb.app"
VM_WORKER_URLS="https://backup-one.example,https://backup-two.example"

# Cloud frame budget. Higher values use more bandwidth.
MAX_FPS="3"
FRAME_QUALITY="52"

# Keep false unless you intentionally want to spend Vercel Sandbox transfer.
ENABLE_VERCEL_SANDBOX_FALLBACK="false"
